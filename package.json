{
  "name": "sms-expense-tracker",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/vector-icons": "~14.0.4",
    "@notifee/react-native": "^9.1.8",
    "@react-native/js-polyfills": "0.76.9",
    "expo": "~52.0.49",
    "expo-dev-client": "~5.0.20",
    "expo-local-authentication": "~15.0.2",
    "expo-modules-autolinking": "~2.0.0",
    "expo-router": "~4.0.22",
    "expo-secure-store": "~14.0.1",
    "expo-sqlite": "~15.1.4",
    "expo-status-bar": "~2.0.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.9",
    "react-native-gifted-charts": "^1.4.4",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/jest": "^29.5.14",
    "@types/react": "~18.3.12",
    "ajv": "^8.20.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~8.0.1",
    "jest": "^29.7.0",
    "jest-expo": "~52.0.6",
    "metro": "^0.81.0",
    "metro-resolver": "^0.81.0",
    "typescript": "~5.7.2"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {
      "^.+\\.[jt]sx?$": "babel-jest"
    },
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json",
      "node"
    ],
    "testMatch": [
      "**/__tests__/**/*.ts"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(react-native|react-native-web|@notifee|@expo/vector-icons|expo-*/))"
    ]
  },
  "private": true
}
